# Environment Variables Template
# Copy this file to .env and fill in your own values

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Get this from MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
MONGODB_URI=your_mongodb_connection_string_here

# JWT Configuration
# Generate a secure random string for production
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Cloudinary Configuration
# Get these from Cloudinary Dashboard (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:8001

# Email / SMTP Configuration
# For Gmail: use SMTP_EMAIL + an App Password in SMTP_PASSWORD
SMTP_EMAIL=your_email@example.com
SMTP_PASSWORD=your_app_password

# Optional explicit SMTP host/port (leave blank to use Gmail service mode)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Optional sender branding
FROM_NAME=Youth Action Network
# FROM_EMAIL=no-reply@example.com
